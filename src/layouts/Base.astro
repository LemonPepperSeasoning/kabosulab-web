---
// Every page: SEO (title, description, canonical, Open Graph, Twitter), the theme, header and footer.
// App pages pass `app`; the studio pages leave it out.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { studio, href, type App } from '../apps';

interface Props {
  title: string;
  description: string;
  app?: App;
  jsonLd?: object;
  noindex?: boolean;
}
const { title, description, app, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Only apps have share images so far.
const og = app && new URL(href(`${app.slug}/og.png`), Astro.site).href;
const icon = app ? href(`${app.slug}/apple-touch-icon.png`) : href('favicon.svg');
---
<!doctype html>
<html lang="en" data-theme={app?.slug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={app?.slug === 'hasha' ? '#0A0A0B' : '#FAFAF7'} />
    <link rel="icon" href={app ? href(`${app.slug}/app-icon.png`) : href('favicon.svg')} />
    <link rel="apple-touch-icon" href={icon} />
    <link rel="sitemap" href={href('sitemap-index.xml')} />
    {app?.appStoreId && <meta name="apple-itunes-app" content={`app-id=${app.appStoreId}`} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={app?.name ?? studio.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {og && <meta name="twitter:image" content={og} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header app={app} />
    <main id="main"><slot /></main>
    <Footer app={app} />
  </body>
</html>
