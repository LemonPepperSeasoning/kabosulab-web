---
// Every page: language, SEO (title, description, canonical, hreflang, Open Graph, Twitter), header and footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { t, path, type Lang } from '../i18n/site';

interface Props {
  lang: Lang;
  page: '' | 'support/' | 'privacy/';
  title: string;
  description: string;
  jsonLd?: object;
  noindex?: boolean;
}
const { lang, page, title, description, jsonLd, noindex = false } = Astro.props;
const s = t[lang];
const origin = Astro.site!.origin;
const url = (l: Lang) => new URL(path(l, page), origin).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}hinto/og/og-${lang}.png`, origin).href;
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url(lang)} />}
    {!noindex && <link rel="alternate" hreflang="en" href={url('en')} />}
    {!noindex && <link rel="alternate" hreflang="ja" href={url('ja')} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={url('en')} />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ECE8E1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191715" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}hinto/app-icon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}hinto/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    {site.appStoreId && <meta name="apple-itunes-app" content={`app-id=${site.appStoreId}`} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hinto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={s.ogLocale} />
    <meta property="og:locale:alternate" content={t[lang === 'en' ? 'ja' : 'en'].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} page={page} />
  </body>
</html>
