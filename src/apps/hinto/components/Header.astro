---
import { t, path, type Lang } from '../i18n/site';
interface Props { lang: Lang; page: '' | 'support/' | 'privacy/' }
const { lang, page } = Astro.props;
const other: Lang = lang === 'en' ? 'ja' : 'en';
---
<header class="container top">
  <a class="brand" href={path(lang, '')}>
    <img src={`${import.meta.env.BASE_URL}hinto/app-icon.png`} alt="" width="28" height="28" />
    <span>Hinto</span>
  </a>
  <a class="lang" href={path(other, page)} hreflang={t[other].htmlLang} lang={t[other].htmlLang}>{t[lang].switchLabel}</a>
</header>
<style>
  .top { display: flex; align-items: center; justify-content: space-between; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-size: 1.25rem; font-weight: 800; }
  .brand img { border-radius: 6px; }
  .lang { font-weight: 700; font-size: var(--fs-small); min-height: 44px; display: inline-flex; align-items: center; padding: 0 4px; }
</style>
