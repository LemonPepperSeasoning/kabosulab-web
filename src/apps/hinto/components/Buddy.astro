---
// A study buddy as inline SVG (so the idle/blink/tail CSS animates). Poses: idle, happy, sleep. Decorative.
const svgs = import.meta.glob('../assets/buddies/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { name: 'kotaro' | 'pochi' | 'kai'; pose?: 'idle' | 'happy' | 'sleep'; size?: number; delay?: string; class?: string }
const { name, pose = 'idle', size = 96, delay = '0s', class: extra = '' } = Astro.props;
const svg = svgs[`../assets/buddies/${name}.svg`];
---
<span class={`mascot pose-${pose} ${extra}`} style={`width:${size}px;height:${size}px;--delay:${delay}`} aria-hidden="true" set:html={svg} />
