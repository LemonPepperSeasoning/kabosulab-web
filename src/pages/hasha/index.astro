---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import { app, appStoreURL, studio } from '../../apps';
import home from '../../assets/hasha/1-home.png';
import collision from '../../assets/hasha/3-collision.png';
import settings from '../../assets/hasha/2-settings.png';

const hasha = app('hasha');
const title = 'Hasha: find SHA-256 collisions on your iPhone';
const description = 'Pick how many bits must match and let your iPhone hunt for a SHA-256 collision on every CPU core or the GPU. Free, open source, no tracking.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Hasha',
  operatingSystem: `iOS ${hasha.minimumIOS} or later`,
  applicationCategory: 'UtilitiesApplication',
  description,
  installUrl: appStoreURL(hasha),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: studio.name },
};

const features = [
  { title: 'Watch the search', body: 'A live count of hashes, the speed, and how many to expect. Up to 48 bits finishes in seconds. 256 bits never finishes, and that’s the point.' },
  { title: 'See the collision', body: 'A grid of the 256 bits shows which match. Both inputs, both hashes and the salt are there, and a tap copies any of them.' },
  { title: 'Rerun any search', body: 'Every search has a seed. The same seed and settings find the exact same collision, after the exact same number of hashes.' },
  { title: 'Built for the GPU', body: 'Parallel collision search with distinguished points, so thousands of Metal threads search at once with little memory. Pause any time; it picks up where it left off.' },
];
---
<Base {title} {description} app={hasha} {jsonLd}>
  <section class="container hero">
    <div class="copy">
      <p class="eyebrow">SHA-256 · 24 to 256 bits</p>
      <h1>Two inputs. <span class="accent">The same hash.</span></h1>
      <p class="lead">A full SHA-256 collision would take longer than the age of the universe. Hasha shows how close your iPhone can get: pick how many leading bits must match, and it searches on every CPU core or the GPU.</p>
      <div class="install">
        <AppStoreBadge app={hasha} />
        <p class="muted small">Free · iPhone and iPad · iOS {hasha.minimumIOS} or later</p>
      </div>
    </div>
    <div class="shots">
      <Shot src={home} alt="Hasha searching 64 bits on the GPU: 2.05 billion hashes so far, 306 million a second, about 5.38 billion expected." width={260} eager />
      <Shot src={collision} alt="Collision found after 2.36 million hashes: the bit grid with the first 40 bits lit, both inputs and their matching hashes." width={260} eager />
    </div>
  </section>

  <section class="container section">
    <ul class="features">
      {features.map((f) => (
        <li class="card">
          <h2>{f.title}</h2>
          <p class="muted">{f.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section split">
    <Shot src={settings} alt="Hasha settings: bits to match from 24 to 256, GPU or CPU, and a seed." width={260} />
    <div>
      <h2>Private by design</h2>
      <p class="lead">No account, no ads, no tracking, no network. Every hash is computed on your device, and nothing leaves it.</p>
      <p class="lead">Hasha is open source under the MIT license. <a href="https://github.com/LemonPepperSeasoning/Hasher">Read the code on GitHub</a>, including <a href="https://github.com/LemonPepperSeasoning/Hasher/blob/main/docs/algorithm.md">how the search works</a>.</p>
    </div>
  </section>
</Base>
<style>
  .hero { display: grid; gap: 48px; padding-top: clamp(24px, 6vw, 72px); align-items: center; }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.1fr 1fr; } }
  .eyebrow { color: var(--accent-text); font: 500 .875rem/1 var(--font-mono); letter-spacing: .02em; margin-bottom: 18px; }
  .accent { color: var(--accent); }
  .lead { margin-top: 20px; }
  .install { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .small { font-size: var(--fs-small); }
  .shots { display: flex; gap: 20px; justify-content: center; }
  .shots :global(.shot):nth-child(2) { margin-top: 48px; }
  .shots :global(img) { width: min(260px, 42vw); }
  .features { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .features h2 { font-size: 1.1875rem; margin-bottom: 10px; }
  .split { display: grid; gap: 40px; align-items: center; }
  .split :global(.shot) { justify-self: center; }
  .split :global(img) { width: min(260px, 70vw); }
  @media (min-width: 800px) { .split { grid-template-columns: auto 1fr; gap: 72px; } }
</style>
