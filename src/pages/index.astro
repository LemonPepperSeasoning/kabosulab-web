---
import Base from '../layouts/Base.astro';
import { apps, studio, href } from '../apps';
---
<Base title={studio.name} description={`${studio.name} makes small, private iPhone apps.`}>
  <section class="container section">
    <h1>{studio.name}</h1>
    <p class="lead">Small iPhone apps that do one thing well. No accounts, no ads, no tracking.</p>
    <ul class="apps">
      {apps.map((a) => (
        <li>
          <a class="card app" href={a.externalURL ?? href(`${a.slug}/`)}>
            <img src={href(`${a.slug}/app-icon.png`)} alt="" width="64" height="64" />
            <span>
              <h2>{a.name}</h2>
              <span class="muted">{a.tagline}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="muted contact">Contact: <a href={`mailto:${studio.email}`}>{studio.email}</a></p>
  </section>
</Base>
<style>
  .lead { margin-top: 16px; }
  .apps { list-style: none; padding: 0; margin: 48px 0 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .app { display: flex; gap: 16px; align-items: center; color: var(--ink); text-decoration: none; height: 100%; }
  .app:hover { border-color: var(--accent); }
  .app img { border-radius: 22%; flex: none; }
  .app h2 { font-size: 1.25rem; margin-bottom: 4px; }
  .contact { margin-top: 48px; }
</style>
