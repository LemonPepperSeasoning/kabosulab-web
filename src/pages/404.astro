---
import Studio from '../layouts/Studio.astro';
import { href } from '../apps';
---
<Studio title="Page not found" description="This page doesn't exist." noindex>
  <script is:inline define:vars={{ base: href(''), apps: ['hinto'] }}>
    // A missing address under an app with its own 404 page goes there, so it looks like the rest of that app.
    const app = apps.find((a) => location.pathname.startsWith(`${base}${a}/`));
    if (app && !location.pathname.startsWith(`${base}${app}/404/`)) location.replace(`${base}${app}/404/`);
  </script>
  <section class="container section">
    <h1>Page not found</h1>
    <p class="lead" style="margin-top:16px">This page doesn’t exist. <a href={href('')}>Go to the home page</a>.</p>
  </section>
</Studio>
